<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/moodlereader/db" VERSION="20260730" COMMENT="Reading-programme activity that delivers book quizzes via the mreader.org service."
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="moodlereader" COMMENT="One record per moodlereader activity instance.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="availablefrom" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="availableuntil" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="maxgrade" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="true" DEFAULT="100" SEQUENCE="false" COMMENT="Maximum grade for the activity in the gradebook."/>
        <FIELD NAME="goal" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Target number of words (or points) for full marks."/>
        <FIELD NAME="wordsorpoints" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 = grade by words read, 1 = grade by points."/>
        <FIELD NAME="minpassgrade" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="60" SEQUENCE="false" COMMENT="Minimum quiz percentage to pass a book."/>
        <FIELD NAME="ignoredate" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Only attempts finished at/after this time count toward the grade."/>
        <FIELD NAME="levelcheck" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 = restrict the books a student may attempt to their reading level."/>
        <FIELD NAME="thislevel" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="6" SEQUENCE="false"/>
        <FIELD NAME="prevlevel" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="3" SEQUENCE="false"/>
        <FIELD NAME="lowerlevels" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1: prevlevel books may be read at every level below the student's, not only one level below."/>
        <FIELD NAME="waitlevel" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Which level picks a wait-time rule: 0 the student's reading level, 1 the book's level."/>
        <FIELD NAME="nextlevel" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="bookinstances" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 = only books linked to this instance are available."/>
        <FIELD NAME="showprogressbar" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="extraprogressbar" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="1 = once the goal is reached, a second bar shows the extra reading."/>
        <FIELD NAME="seb" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Safe Exam Browser for the quizzes: 0 = not required, 1 = required. The site setting comes first."/>
        <FIELD NAME="sebmethod" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 = a configuration made by Moodle, 2 = a SEB template, 3 = copied from a quiz (Config Key checked); 1 = SEB's own configuration (Browser Exam Keys checked)."/>
        <FIELD NAME="sebkeys" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Allowed Browser Exam Keys, one per line."/>
        <FIELD NAME="sebquitpassword" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Password to quit SEB, put (hashed) into the configuration Moodle makes."/>
        <FIELD NAME="sebtemplateid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The SEB template (quizaccess_seb_template.id) when sebmethod is 2."/>
        <FIELD NAME="sebconfigxml" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="A SEB configuration copied from a quiz (plist XML) when sebmethod is 3."/>
        <FIELD NAME="showlevel" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Show the reading-level panel on the activity page."/>
        <FIELD NAME="showbooksread" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Show the covers of books read on the activity page."/>
        <FIELD NAME="showreport" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Show the this-term reading report on the activity page."/>
        <FIELD NAME="showsearch" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Show the book search on the activity page."/>
        <FIELD NAME="completionpass" TYPE="int" LENGTH="1" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="completiontotalwords" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="cheatsettings" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON cheating-detection settings; null means the defaults."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="moodlereader_books" COMMENT="Book catalogue synced from mreader.org (quizzes are taken remotely).">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="remoteid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The book's id on mreader.org, used to fetch its cover image."/>
        <FIELD NAME="publisher" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="series" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Named 'level' in the legacy plugin; the publisher's series/level label."/>
        <FIELD NAME="difficulty" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Numeric reading difficulty used for level filtering."/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="words" TYPE="int" LENGTH="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="genre" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="fiction" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="points" TYPE="number" LENGTH="10" DECIMALS="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="image" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Book-cover image identifier used by the mreader.org quiz URL."/>
        <FIELD NAME="sametitle" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="language" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The book's language code from mreader.org; empty when unknown."/>
        <FIELD NAME="hidden" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="localedits" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Details changed on this site, as JSON: field => {local, remote}. The sync keeps the local value and records mreader.org's."/>
        <FIELD NAME="time" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="withdrawn" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 when mreader.org no longer offers this book's quiz."/>
        <FIELD NAME="hasquiz" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="0 for a book mreader.org has no quiz for (credit can still be awarded); its remoteid is then in mreader.org's no-quiz id space."/>
        <FIELD NAME="coveretag" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="mreader.org's ETag for the cached cover image."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="publisher_series" UNIQUE="false" FIELDS="publisher, series"/>
        <INDEX NAME="remoteid" UNIQUE="false" FIELDS="remoteid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="moodlereader_bookinstances" COMMENT="Links a book to a specific moodlereader instance (optional per-instance catalogue).">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="readerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="bookid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="difficulty" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="words" TYPE="int" LENGTH="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="points" TYPE="number" LENGTH="10" DECIMALS="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="readerid" TYPE="foreign" FIELDS="readerid" REFTABLE="moodlereader" REFFIELDS="id"/>
        <KEY NAME="bookid" TYPE="foreign" FIELDS="bookid" REFTABLE="moodlereader_books" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="moodlereader_users" COMMENT="Maps a Moodle user to the anonymous identity used on mreader.org.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="uniqueid" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false" COMMENT="Opaque per-user id sent to mreader.org as the username."/>
        <FIELD NAME="uniquename" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Opaque per-user display name sent to mreader.org."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign-unique" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="uniqueid" UNIQUE="true" FIELDS="uniqueid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="moodlereader_attempts" COMMENT="One record per book-quiz attempt (quiz itself is taken on mreader.org).">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="readerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="bookid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="attempt" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="state" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="inprogress" SEQUENCE="false"/>
        <FIELD NAME="percentgrade" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="passed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="credit" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="cheated" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="deleted" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="bookrating" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timestart" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timefinish" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="ip" TYPE="char" LENGTH="45" NOTNULL="true" SEQUENCE="false" COMMENT="Remote address at attempt time, used by cheating detection."/>
        <FIELD NAME="attemptref" TYPE="char" LENGTH="40" NOTNULL="false" SEQUENCE="false" COMMENT="Opaque reference that identifies this attempt to mreader.org (API v2); null for attempts that never launched."/>
        <FIELD NAME="remotestate" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Last attempt state reported by mreader.org."/>
        <FIELD NAME="timeresultchecked" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="When mreader.org was last asked for this attempt's result."/>
        <FIELD NAME="delivery" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="iframe" SEQUENCE="false" COMMENT="moodle (drawn by Moodle, 31 §11; the only way now), or iframe for attempts made before quizzes were shown in Moodle only."/>
        <FIELD NAME="timelimit" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Moodle-drawn: the quiz's time limit in seconds, from mreader.org."/>
        <FIELD NAME="slots" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Moodle-drawn: how many questions the quiz serves."/>
        <FIELD NAME="currentslot" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Moodle-drawn: the slot on screen (0 before the quiz starts). The question text is never stored."/>
        <FIELD NAME="secondsused" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Moodle-drawn: seconds a question was on screen, counted by Moodle (the clock pauses while waiting for mreader.org)."/>
        <FIELD NAME="timeserved" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Moodle-drawn: when the current question page was sent, or 0 while no question is on screen."/>
        <FIELD NAME="timeheartbeat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Moodle-drawn: the last sign that the question page was still open."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="readerid" TYPE="foreign" FIELDS="readerid" REFTABLE="moodlereader" REFFIELDS="id"/>
        <KEY NAME="bookid" TYPE="foreign" FIELDS="bookid" REFTABLE="moodlereader_books" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="readerid_userid" UNIQUE="false" FIELDS="readerid, userid"/>
        <INDEX NAME="attemptref" UNIQUE="false" FIELDS="attemptref"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="moodlereader_cheatlog" COMMENT="Suspected-cheating clusters flagged for teacher review.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="readerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="otherattemptid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="otheruserid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="reason" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="detail" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Marker-specific number: seconds apart, quiz duration, or quizzes in the burst."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="readerid" TYPE="foreign" FIELDS="readerid" REFTABLE="moodlereader" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="attemptid" UNIQUE="false" FIELDS="attemptid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="moodlereader_messages" COMMENT="Teacher messages shown to students on the activity page.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="readerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Target user, or 0 for everyone in the instance."/>
        <FIELD NAME="messagetext" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="messageformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="readerid" TYPE="foreign" FIELDS="readerid" REFTABLE="moodlereader" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="readerid_userid" UNIQUE="false" FIELDS="readerid, userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="moodlereader_grades" COMMENT="Cached aggregate grade per user per instance (pushed to the gradebook).">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="readerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="rawgrade" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="datesubmitted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="dategraded" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="readerid" TYPE="foreign" FIELDS="readerid" REFTABLE="moodlereader" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="readerid_userid" UNIQUE="false" FIELDS="readerid, userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="moodlereader_levels" COMMENT="Per-user reading level within an instance.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="readerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="goal" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Per-user reading goal override; 0 means use the activity default."/>
        <FIELD NAME="startlevel" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="currentlevel" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="stoplevel" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="allowpromotion" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="time" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="promoted" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The level the student last moved up from, until their reading page has told them; 0 when there is nothing to tell. Stored plus one, so a move from level 0 is 1."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="readerid" TYPE="foreign" FIELDS="readerid" REFTABLE="moodlereader" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="readerid_userid" UNIQUE="true" FIELDS="readerid, userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="moodlereader_imports" COMMENT="One row per mod_reader activity being imported: links it to its new activity and records the sync and cutover state.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="legacyreaderid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The mod_reader instance id (reader.id)."/>
        <FIELD NAME="legacycmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="newreaderid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="newcmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="synced" SEQUENCE="false" COMMENT="synced (hidden copy, can be re-synced) or cutover (live, no longer synced)."/>
        <FIELD NAME="counts" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON summary of the last sync."/>
        <FIELD NAME="timesynced" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecutover" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="legacyreaderid" UNIQUE="true" FIELDS="legacyreaderid"/>
        <INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="moodlereader_importmap" COMMENT="Maps each imported mod_reader row to the row it became, with a hash of its imported content, so that a re-sync only touches what changed.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="importid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="moodlereader_imports.id, or 0 for site-wide rows (books, identities)."/>
        <FIELD NAME="itemtype" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="legacyid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="legacysub" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Second key part, for one legacy row that becomes several new rows."/>
        <FIELD NAME="newid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="hash" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="item" UNIQUE="true" FIELDS="importid, itemtype, legacyid, legacysub"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="moodlereader_booksused" COMMENT="Books a student has used up for life: kept when a course is reset or an activity or course is deleted, so the book is never offered to them again.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="bookid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="passed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="credit" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="cheated" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
