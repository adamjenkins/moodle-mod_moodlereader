        <FIELD NAME="uniquename" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Random full name that is used as the name of user on external quiz sites"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="readuser_use_ix" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id" COMMENT="id in user table"/>
