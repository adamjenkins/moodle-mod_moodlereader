        <INDEX NAME="readatte_tim_ix" UNIQUE="false" FIELDS="timefinish"/>
        <INDEX NAME="readatte_paschedel_ix" UNIQUE="false" FIELDS="passed, cheated, deleted"/>
      </INDEXES>
